class Patterns 
{ 
   public static void main(String args[]) 
   { 
       int i, j;
       for(i = 5; i >= 1; i--)  // Loops from 5 to 1
       {
           for(j = 1; j <= i; j++)  // Prints numbers from 1 to i
           {
               System.out.print(j + " ");  
           }
           System.out.println(); // Moves to next line
       }
   }
}
